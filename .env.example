# Contact form (src/app/api/send/route.ts). Copy to .env.local and fill in.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender shown on the delivered email. The default (onboarding@resend.dev) only
# delivers to the email of the Resend account owner. To deliver to
# contact@devnambiar.in, verify devnambiar.in in Resend (DNS records) and use an
# address on it, e.g. Portfolio <contact@devnambiar.in>
CONTACT_FROM=Portfolio <onboarding@resend.dev>

# Where form messages are delivered. Defaults to contact@devnambiar.in. While the
# domain is not verified in Resend, set this to the Resend account email.
CONTACT_TO=
